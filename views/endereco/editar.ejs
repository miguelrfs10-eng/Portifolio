<% title = "Editar endereço" %>

<div class="container my-5">

    <div class="row justify-content-center">

        <div class="col-12 col-lg-9">

            <div class="mb-4">

                <h1 class="carrinho-titulo">
                    Editar endereço
                </h1>

                <p class="text-secondary">
                    Informe o endereço que será usado nas suas entregas.
                </p>

            </div>

            <% if (erro) { %>
                <div class="alert alert-danger" role="alert">
                    <%= erro %>
                </div>
            <% } %>

            <div class="carrinho-resumo">

                <form action="/usuarios/endereco" method="POST">

                    <div class="row g-4">

                        <div class="col-12 col-md-8">

                            <label for="rua" class="form-label">
                                Rua
                            </label>

                            <input
                                type="text"
                                class="form-control perfil-input"
                                id="rua"
                                name="rua"
                                maxlength="200"
                                value="<%= endereco.Rua || '' %>"
                                required
                            >

                        </div>

                        <div class="col-12 col-md-4">

                            <label for="numero" class="form-label">
                                Número
                            </label>

                            <input
                                type="text"
                                class="form-control perfil-input"
                                id="numero"
                                name="numero"
                                maxlength="20"
                                value="<%= endereco.Numero || '' %>"
                                required
                            >

                        </div>

                        <div class="col-12 col-md-6">

                            <label for="bairro" class="form-label">
                                Bairro
                            </label>

                            <input
                                type="text"
                                class="form-control perfil-input"
                                id="bairro"
                                name="bairro"
                                maxlength="100"
                                value="<%= endereco.Bairro || '' %>"
                                required
                            >

                        </div>

                        <div class="col-12 col-md-6">

                            <label for="complemento" class="form-label">
                                Complemento
                            </label>

                            <input
                                type="text"
                                class="form-control perfil-input"
                                id="complemento"
                                name="complemento"
                                maxlength="100"
                                value="<%= endereco.Complemento || '' %>"
                            >

                        </div>

                        <div class="col-12 col-md-6">

                            <label for="cidade" class="form-label">
                                Cidade
                            </label>

                            <input
                                type="text"
                                class="form-control perfil-input"
                                id="cidade"
                                name="cidade"
                                maxlength="100"
                                value="<%= endereco.Cidade || '' %>"
                                required
                            >

                        </div>

                        <div class="col-12 col-md-3">

                            <label for="estado" class="form-label">
                                Estado
                            </label>

                            <input
                                type="text"
                                class="form-control perfil-input"
                                id="estado"
                                name="estado"
                                maxlength="2"
                                placeholder="SP"
                                value="<%= endereco.Estado || '' %>"
                                required
                            >

                        </div>

                        <div class="col-12 col-md-3">

                            <label for="cep" class="form-label">
                                CEP
                            </label>

                            <input
                                type="text"
                                class="form-control perfil-input"
                                id="cep"
                                name="cep"
                                maxlength="9"
                                placeholder="00000-000"
                                value="<%= endereco.CEP || '' %>"
                                required
                            >

                        </div>

                    </div>

                    <div class="d-flex flex-column flex-md-row gap-2 mt-4">

                        <button type="submit" class="btn login-btn pedido-btn">

                            <i class="bi bi-check-lg"></i>

                            Salvar endereço

                        </button>

                        <a href="/usuarios/endereco" class="btn carrinho-btn-ver pedido-btn">

                            <i class="bi bi-x-lg"></i>

                            Cancelar

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>