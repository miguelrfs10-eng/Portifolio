<% title='Página inicial' %>

  <style>
    #carouselExampleInterval {
      background-color: #1a1d20;
    }

    .carousel-img {
      height: 480px;
      object-fit: cover;
      width: 100%;
    }

    @media (max-width: 768px) {
      .carousel-img {
        height: 240px;
      }
    }
  </style>



  <div class="container-md my-4">
    <div id="carouselExampleInterval" class="carousel slide carousel-fade shadow-sm mb-5" data-bs-ride="carousel">
      <div class="carousel-inner">

        <div class="carousel-item active" data-bs-interval="10000">
          <div class="h-100">
            <img src="./imagens/Mordern.png" class="carousel-img img-fluid" alt="Primeira imagem">
          </div>
        </div>

        <div class="carousel-item" data-bs-interval="10000">
          <div class="h-100">
            <img src="./imagens/Modern charger.png" class="carousel-img img-fluid" alt="Segunda imagem">
          </div>
        </div>

        <div class="carousel-item" data-bs-interval="10000">
          <div class="h-100">
            <img src="/imagens/Modern charger photo.png" class="carousel-img img-fluid" alt="Terceira imagem">
          </div>
        </div>

      </div>

      <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleInterval"
        data-bs-slide="prev">
        <span class="carousel-control-prev-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
        <span class="visually-hidden">Anterior</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleInterval"
        data-bs-slide="next">
        <span class="carousel-control-next-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
        <span class="visually-hidden">Próximo</span>
      </button>
    </div>
  </div>

  <!-- CATEGORIAS EM DESTAQUE -->
  <div class="container-md my-5">
    <div class="row g-3">

      <div class="col-12 col-md-6">
        <a href="/produto?q=carregador" class="categoria-card">
          <i class="bi bi-lightning-charge-fill"></i>
          <span>Carregadores</span>
        </a>
      </div>

      <div class="col-12 col-md-6">
        <a href="/produto?q=cabo" class="categoria-card">
          <i class="bi bi-usb-plug-fill"></i>
          <span>Cabos</span>
        </a>
      </div>

    </div>
  </div>


  <div class="container-md my-4">
    <div class="row g-3 justify-content-center">

      <% if (produtos && produtos.length> 0) { %>

        <% produtos.slice(0, 8).forEach(function(produto, indice) { %>

          <div class="col-6 col-md-3">
            <div class="card h-100 border-0 shadow-sm position-relative">

              <% if (indice===0) { %>
                <span class="produto-badge produto-badge-vendido">Mais vendido</span>
                <% } else if (indice===1) { %>
                  <span class="produto-badge produto-badge-novo">Novo</span>
                  <% } %>

                    <div class="card-body d-flex flex-column justify-content-between">
                      <div class="text-center mb-3">
                        <img src="<%= produto.imagem || 'https://via.placeholder.com/300x300?text=Sem+imagem' %>"
                          alt="<%= produto.nome %>" class="img-fluid rounded"
                          style="max-height: 180px; object-fit: contain;">
                      </div>
                      <div>
                        <h5 class="card-title fs-6">
                          <%= produto.nome %>
                        </h5>
                        <p class="card-text fw-bold" style="color: #c5a880;">
                          R$ <%= Number(produto.preco).toFixed(2).replace('.', ',' ) %>
                        </p>
                      </div>
                      <a href="/produto/<%= produto.uid %>" class="btn btn-primary w-100 mt-2">Comprar</a>
                    </div>
            </div>
          </div>

          <% }) %>

            <% } else { %>

              <p class="text-secondary text-center">Nenhum produto cadastrado ainda.</p>

              <% } %>

    </div>
  </div>