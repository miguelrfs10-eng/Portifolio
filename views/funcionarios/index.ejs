<% title = "Funcionários" %>

<div class="container my-4">

    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="carrinho-titulo">Gestão de Funcionários</h1>
        </div>
        <div class="col-auto">
            <a href="/funcionarios/novo" class="btn login-btn btn-sm">+ Funcionário</a>
        </div>
    </div>

    <% if (funcionarios.length === 0) { %>

        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card carrinho-vazio-card text-center p-5">
                    <h5 class="card-title">Nenhum funcionário cadastrado</h5>
                    <p class="card-text">Adicione o primeiro funcionário da loja.</p>
                    <a href="/funcionarios/novo" class="btn login-btn mx-auto mt-2">+ Adicionar Funcionário</a>
                </div>
            </div>
        </div>

    <% } else { %>

        <div class="carrinho-lista">

            <% funcionarios.forEach(funcionario => { %>

                <div class="carrinho-item">

                    <div class="carrinho-item-info">
                        <h5 class="carrinho-item-nome"><%= funcionario.nomeCompleto %></h5>
                        <p class="mb-1">Usuário: <%= funcionario.nomeUsuario %></p>
                        <p class="mb-0">Cargo: <%= funcionario.cargo %></p>
                    </div>

                    <div class="carrinho-item-acoes">
                        <a href="/funcionarios/<%= funcionario.id %>" class="btn btn-sm carrinho-btn-ver">Ver</a>
                        <a href="/funcionarios/<%= funcionario.id %>/editar" class="btn btn-sm carrinho-btn-editar">Editar</a>
                        <form action="/funcionarios/<%= funcionario.id %>/remover" method="post" class="d-inline"
                            onsubmit="return confirm('Confirmar remover o funcionário?')">
                            <button type="submit" class="btn btn-sm carrinho-btn-remover">Remover</button>
                        </form>
                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>