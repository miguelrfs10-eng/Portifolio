<% title = "Logar" %>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-11 col-sm-8 col-md-6 col-lg-4">

            <div class="card login-card shadow-sm">
                <div class="card-body p-4 p-md-5">

                    <h2 class="login-titulo text-center mb-4">LOGIN</h2>

                    <% if (erro) { %>
                        <div class="alert alert-danger" role="alert">
                            <%= erro %>
                        </div>
                    <% } %>

                    <form action="/logar/login" method="post">
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" name="email" id="email" required>
                        </div>
                        <div class="mb-3">
                            <label for="senha" class="form-label">Senha</label>
                            <input type="password" class="form-control" name="senha" id="senha" required>
                        </div>
                        <button type="submit" class="btn login-btn w-100 mt-2">Entrar</button>

                        <p class="signup text-center mb-0 mt-3">Não tem uma conta?
                            <a rel="noopener noreferrer" href="/logar/cadastro">Cadastre-se</a>
                        </p>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>