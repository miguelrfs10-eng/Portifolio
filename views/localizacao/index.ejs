<% title = "Localização da Loja" %>

<div class="container my-5">

    <div class="row justify-content-center">

        <div class="col-12 col-lg-9">

            <div class="mb-4">

                <h1 class="carrinho-titulo">Localização da loja</h1>

                <p class="text-secondary">
                    Confira onde estamos e nosso horário de atendimento.
                </p>

            </div>

            <div class="carrinho-resumo">

                <div class="d-flex align-items-center gap-3 mb-4">

                    <div class="perfil-avatar">
                        <i class="bi bi-geo-alt"></i>
                    </div>

                    <div>

                        <h4 class="mb-1">Carga Top</h4>

                        <small class="text-secondary">
                            Loja física e centro de distribuição
                        </small>

                    </div>

                </div>

                <hr>

                <div class="row g-4 mt-1">

                    <div class="col-12 col-md-8">

                        <label class="form-label">Endereço</label>

                        <input
                            type="text"
                            class="form-control perfil-input"
                            value="Av. Eng. Eusébio Stevaux, 823 - Jurubatuba, São Paulo - SP"
                            readonly
                        >

                    </div>

                    <div class="col-12 col-md-4">

                        <label class="form-label">CEP</label>

                        <input
                            type="text"
                            class="form-control perfil-input"
                            value="04696-000"
                            readonly
                        >

                    </div>

                    <div class="col-12 col-md-6">

                        <label class="form-label">Horário de atendimento</label>

                        <input
                            type="text"
                            class="form-control perfil-input"
                            value="Segunda a sexta, das 08h às 18h"
                            readonly
                        >

                    </div>

                    <div class="col-12 col-md-6">

                        <label class="form-label">Telefone</label>

                        <input
                            type="text"
                            class="form-control perfil-input"
                            value="(11) 99999-9999"
                            readonly
                        >

                    </div>

                </div>

                <hr class="my-4">

                <div class="ratio ratio-16x9 rounded overflow-hidden">
                    <iframe
                        src="https://www.google.com/maps?q=Av.+Eng.+Eus%C3%A9bio+Stevaux,+823+-+Jurubatuba,+S%C3%A3o+Paulo+-+SP&output=embed"
                        style="border:0;"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                    ></iframe>
                </div>

                <div class="d-flex flex-column flex-md-row gap-2 mt-4">

                    <a
                        href="https://www.google.com/maps/search/?api=1&query=Av.+Eng.+Eus%C3%A9bio+Stevaux,+823+-+Jurubatuba,+S%C3%A3o+Paulo+-+SP"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn login-btn pedido-btn"
                    >
                        <i class="bi bi-signpost-2"></i>
                        Traçar rota
                    </a>

                    <a href="/usuarios/suporte" class="btn carrinho-btn-ver pedido-btn">
                        <i class="bi bi-headset"></i>
                        Falar com suporte
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>