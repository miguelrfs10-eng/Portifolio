<style>
    .acomp-linha { display: flex; justify-content: space-between; position: relative; margin: 18px 0 6px; }
    .acomp-linha::before { content: ""; position: absolute; top: 15px; left: 12%; right: 12%; height: 2px; background: #2a2a2f; }
    .acomp-etapa { flex: 1; text-align: center; position: relative; z-index: 1; font-size: 12px; color: #8e8e93; }
    .acomp-bolinha { width: 30px; height: 30px; border-radius: 50%; margin: 0 auto 6px; display: flex; align-items: center; justify-content: center;
        background: #111114; border: 2px solid #2a2a2f; font-size: 14px; }
    .acomp-etapa.feita { color: #e2e2e6; }
    .acomp-etapa.feita .acomp-bolinha { background: #c5a880; border-color: #c5a880; color: #0a0a0c; }
    .acomp-etapa.atual { color: #c5a880; font-weight: 600; }
    .acomp-previsao { color: #c5a880; font-weight: 600; }
</style>

<div class="acomp mt-2">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
        <span class="text-secondary">Previsão de entrega</span>
        <span class="acomp-previsao">Até <%= acomp.previsaoTexto %></span>
    </div>

    <div class="acomp-linha">
        <% acomp.etapas.forEach(function (nome, i) { %>
            <div class="acomp-etapa <%= i <= acomp.etapa ? 'feita' : '' %> <%= i === acomp.etapa ? 'atual' : '' %>">
                <div class="acomp-bolinha"><%= i <= acomp.etapa ? '✓' : '' %></div>
                <%= nome %>
            </div>
        <% }) %>
    </div>
</div>