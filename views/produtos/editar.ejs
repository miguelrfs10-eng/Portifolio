<% title = "Editar Produto" %>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">

            <h1 class="titulo-produto mb-4">
                Editar Produto
            </h1>

            <form action="/produto/<%= produto.uid %>/atualizar" method="POST">

                <div class="mb-3">
                    <label for="nome" class="form-label">
                        Nome do produto
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        id="nome"
                        name="nome"
                        value="<%= produto.nome %>"
                        required
                    >
                </div>

                <div class="mb-3">
                    <label for="descricao" class="form-label">
                        Descrição
                    </label>

                    <textarea
                        class="form-control"
                        id="descricao"
                        name="descricao"
                        rows="4"
                        style="resize: none;"
                    ><%= produto.descricao || '' %></textarea>
                </div>

                <div class="mb-3">
                    <label for="categoria" class="form-label">
                        Categoria
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        id="categoria"
                        name="categoria"
                        value="<%= produto.categoria %>"
                        required
                    >
                </div>

                <div class="mb-3">
                    <label for="marca" class="form-label">
                        Marca
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        id="marca"
                        name="marca"
                        value="<%= produto.marca || '' %>"
                    >
                </div>

                <div class="mb-3">
                    <label for="imagem" class="form-label">Link da imagem</label>
                    <input
                        type="text"
                        class="form-control"
                        id="imagem"
                        name="imagem"
                        value="<%= produto.imagem || '' %>"
                        placeholder="/imagens/produtos/nome-do-arquivo.jpg"
                    >
                    <small class="text-secondary">Pode colar um link (http://...) ou o caminho local (/imagens/produtos/arquivo.jpg)</small>
                </div>

                <div class="mb-3">
                    <label for="preco" class="form-label">
                        Preço
                    </label>

                    <div class="stepper-produto" data-passo="1">
                        <button type="button" class="stepper-menos" aria-label="Diminuir">−</button>

                        <input
                            type="number"
                            class="form-control"
                            id="preco"
                            name="preco"
                            step="0.01"
                            min="0"
                            value="<%= Number(produto.preco).toFixed(2) %>"
                            required
                        >

                        <button type="button" class="stepper-mais" aria-label="Aumentar">+</button>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="quantidade" class="form-label">
                        Quantidade em estoque
                    </label>

                    <div class="stepper-produto" data-passo="1">
                        <button type="button" class="stepper-menos" aria-label="Diminuir">−</button>

                        <input
                            type="number"
                            class="form-control"
                            id="quantidade"
                            name="quantidade"
                            min="0"
                            value="<%= produto.quantidade %>"
                            required
                        >

                        <button type="button" class="stepper-mais" aria-label="Aumentar">+</button>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button
                        type="submit"
                        class="btn login-btn"
                    >
                        Salvar alterações
                    </button>

                    <a
                        href="/produto/<%= produto.uid %>"
                        class="btn login-btn"
                    >
                        Cancelar
                    </a>
                </div>

            </form>

            <form
                action="/produto/<%= produto.uid %>/deletar"
                method="POST"
                class="mt-3"
                onsubmit="return confirm('Tem certeza que quer apagar este produto? Essa ação não pode ser desfeita.')"
            >
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    Excluir produto
                </button>
            </form>

        </div>
    </div>
</div>